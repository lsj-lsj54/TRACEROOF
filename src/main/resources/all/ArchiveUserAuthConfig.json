        "evidence:edit",
        "evidence:delete"
      ],
      "description": "查看影像、上传影像、修改影像、删除影像"
    },
    {
      "key": "admin",
      "name": "管理员",
      "permissions": [
        "archiveUser:manage",
        "evidence:view",
        "evidence:upload",
        "evidence:edit",
        "evidence:delete"
      ],
      "description": "成员管理、查看影像、上传影像、修改影像、删除影像"
